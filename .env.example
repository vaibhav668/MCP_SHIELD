# Copy to .env and fill in. Never commit .env.

# The agent (victim) runs on Groq, and the judge uses Groq first because it is the fastest
GROQ_API_KEY=

# Fallback judge, used automatically when Groq is rate limited or down
GOOGLE_API_KEY=
# Optional overrides:
# JUDGE_PROVIDER=gemini                    # try Gemini before Groq
# JUDGE_FALLBACK_MODEL=gemini-3.5-flash-lite
